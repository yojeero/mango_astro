
{
    "label": "Lock",
    "action": "hyprlock",
    "text": "󰍁 Lock",
    "keybind": "l"
}

{
    "label": "Logout",
    "action": "loginctl terminate-user $USER",
    "text": "󰍃 Logout",
    "keybind": "e"
}

{
    "label": "Suspend",
    "action": "systemctl suspend",
    "text": "  Suspend",
    "keybind": "u"
}

{
    "label": "Hibernate",
    "action": "systemctl hibernate",
    "text": "󰙝 Hibernate",
    "keybind": "h"
}

{
    "label": "Shutdown",
    "action": "systemctl poweroff",
    "text": " Shutdown",
    "keybind": "s"
}
 
{
    "label": "Reboot",
    "action": "systemctl reboot",
    "text": " Reboot",
    "keybind": "r"
}

